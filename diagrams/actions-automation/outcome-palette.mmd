%%{init: {"theme":"base","themeVariables":{"fontFamily":"Inter, ui-sans-serif, system-ui","primaryTextColor":"#172033","lineColor":"#94a3b8"},"flowchart":{"curve":"basis","htmlLabels":true}}}%%
flowchart TB
    action["One reusable business task"]
    sequence["A clear sequence of results"]
    action -->|"contains"| sequence

    subgraph choices["Each step delivers a concrete result"]
        direction LR
        data["Update business information<br/><small>find · add · change · remove</small>"]
        builtins["Use a ready Daptin feature<br/><small>email · files · accounts · AI · imports</small>"]
        providers["Update a connected service<br/><small>payments · CRM · support · your chosen service</small>"]
        templates["Create customer-ready content<br/><small>combine saved details into a page, message, or document</small>"]
        events["Send a live update<br/><small>tell the right audience immediately</small>"]
        client["Guide the customer<br/><small>show details · notify · open a page · provide a download</small>"]
    end

    sequence -->|"step 1, 2, 3…"| data
    sequence -->|"step 1, 2, 3…"| builtins
    sequence -->|"step 1, 2, 3…"| providers
    sequence -->|"step 1, 2, 3…"| templates
    sequence -->|"step 1, 2, 3…"| events
    sequence -->|"step 1, 2, 3…"| client

    prior["Results from earlier steps"] -->|"supply details to"| sequence
    conditions["Business conditions"] -->|"select the relevant steps"| sequence
    repeat["A known list of items"] -->|"repeats a step for each item"| sequence

    data --> completion["Completed business result"]
    builtins --> completion
    providers --> completion
    templates --> completion
    events --> completion
    client --> completion

    classDef core fill:#dbeafe,stroke:#2563eb,color:#172554,stroke-width:2px;
    classDef choice fill:#ede9fe,stroke:#7c3aed,color:#3b0764,stroke-width:1.5px;
    classDef context fill:#fef3c7,stroke:#d97706,color:#78350f,stroke-width:1.5px;
    classDef done fill:#dcfce7,stroke:#16a34a,color:#14532d,stroke-width:2px;
    class action,sequence core;
    class data,builtins,providers,templates,events,client choice;
    class prior,conditions,repeat context;
    class completion done;
