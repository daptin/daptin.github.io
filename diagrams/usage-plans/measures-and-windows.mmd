flowchart TB
    subgraph work["Customer activity a plan can count"]
        resources["Viewing, adding, and updating business information"]
        actions["Automated tasks and scheduled routines"]
        ai["AI conversations and content creation"]
        integrations["Updates sent to connected services"]
    end

    measures["What counts toward the plan<br/>requests · file size · AI text · cost · your own business units"]

    subgraph rule["One included allowance"]
        metric["Choose what to count<br/>for example, total AI text"]
        window["Choose when it renews<br/>minute · hour · day · month · subscription period"]
        maximum["Set the included amount"]
        mode["Choose what happens at the limit<br/>pause further use or keep counting"]
    end

    bucket["Allowance for this period<br/>included · set aside · used"]
    record["Customer activity tally<br/>expected amount · final amount · result"]
    billing["Automatic follow-up<br/>update credits, the bill, or a usage report"]

    resources --> measures
    actions --> measures
    ai --> measures
    integrations --> measures

    measures --> metric
    metric --> bucket
    window --> bucket
    maximum --> bucket
    mode --> bucket

    measures --> record
    bucket -->|sets aside the expected amount| record
    record -->|updates the amount actually used| bucket
    record -->|can start when the activity finishes| billing

    classDef source fill:#eef4ff,stroke:#4774c9,color:#15274a,stroke-width:2px;
    classDef measure fill:#f2edff,stroke:#7c5bc4,color:#2d1f52,stroke-width:2px;
    classDef policy fill:#fff4dc,stroke:#c47a12,color:#4a2e08,stroke-width:2px;
    classDef outcome fill:#ebf8ef,stroke:#3f8f5b,color:#163b23,stroke-width:2px;
    class resources,actions,ai,integrations source;
    class measures measure;
    class metric,window,maximum,mode policy;
    class bucket,record,billing outcome;
