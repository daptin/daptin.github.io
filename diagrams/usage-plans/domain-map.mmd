flowchart LR
    account["Customer account"]

    subgraph access["What the customer receives"]
        membership["Active subscription<br/>status and billing period"]
        plan["Plan<br/>name, price and limits"]
        limit["Included allowance<br/>what is counted, for how long, and how much"]
    end

    subgraph activity["What the customer has used"]
        usage["Customer activity<br/>what happened, its result, and the amount used"]
        quota["Allowance balance<br/>amount set aside and amount used"]
    end

    account -->|has| membership
    membership -->|selects| plan
    plan -->|contains| limit
    membership -->|organizes| usage
    plan -->|applies to| usage
    membership -->|organizes| quota
    plan -->|applies to| quota
    limit -->|sets the allowance for each billing period| quota
    usage -->|updates| quota

    classDef person fill:#eef4ff,stroke:#4774c9,color:#15274a,stroke-width:2px;
    classDef plan fill:#fff4dc,stroke:#c47a12,color:#4a2e08,stroke-width:2px;
    classDef record fill:#ebf8ef,stroke:#3f8f5b,color:#163b23,stroke-width:2px;
    class account person;
    class membership,plan,limit plan;
    class usage,quota record;
