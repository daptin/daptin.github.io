flowchart LR
    request["A counted customer activity begins"]
    admission["Plan check<br/>find the customer's active subscription"]
    estimate["Expected amount<br/>requests, file size, AI text, cost, or your own units"]
    available{"Is enough of the<br/>included allowance available?"}
    reached["Allowance used up<br/>tell the customer which limit they reached"]
    held["Expected amount set aside<br/>prevents the same allowance being promised twice"]
    work["The requested feature runs"]

    request --> admission
    estimate --> admission
    admission --> available
    available -->|Yes| held
    available -->|A hard limit is reached| reached
    held --> work

    work -->|Finishes| complete["Finished<br/>replace the estimate with the actual amount used"]
    work -->|Stops early| cancel["Stopped early<br/>release the estimate and count any reported use"]
    held -->|The hold times out| expire["Timed out<br/>return the unused amount to the allowance"]

    complete --> completed["Finished activity in the customer's history"]
    cancel --> cancelled["Stopped activity in the customer's history"]
    expire --> expired["Unused hold removed from the customer's history"]

    classDef input fill:#eef4ff,stroke:#4774c9,color:#15274a,stroke-width:2px;
    classDef decision fill:#fff4dc,stroke:#c47a12,color:#4a2e08,stroke-width:2px;
    classDef active fill:#f2edff,stroke:#7c5bc4,color:#2d1f52,stroke-width:2px;
    classDef outcome fill:#ebf8ef,stroke:#3f8f5b,color:#163b23,stroke-width:2px;
    class request,estimate input;
    class admission,available,reached decision;
    class held,work active;
    class complete,cancel,expire,completed,cancelled,expired outcome;
