flowchart TB
    PROVIDER["Business service<br/>payments, CRM, shipping, or support"]

    subgraph definition["Connected service setup"]
        CATALOG["Service connection<br/>which business service Daptin connects"]
        OPERATIONS["Available tasks<br/>create a payment, find a customer, update a ticket"]
        CONNECTION["Sign-in choice<br/>customer approval or securely saved sign-in details"]
        CATALOG -->|lists| OPERATIONS
        CATALOG -->|uses| CONNECTION
    end

    subgraph product["Where a service task can be used"]
        DIRECT["Product screen<br/>a person starts the task"]
        WORKFLOW["Automatic sequence<br/>the task runs at the right step"]
        GRAPHQL["Connected app or internal tool<br/>starts the same task"]
    end

    RUN["Ready-to-use service task<br/>required details and returned details stay together"]
    RESULT["Returned details<br/>the answer and completion status"]

    OPERATIONS -->|become| RUN
    CONNECTION -->|opens the approved account for| RUN
    DIRECT -->|uses| RUN
    WORKFLOW -->|uses| RUN
    GRAPHQL -->|uses| RUN
    RUN -->|asks| PROVIDER
    PROVIDER -->|returns| RESULT

    classDef outside fill:#F8FAFC,stroke:#64748B,color:#1E293B,stroke-width:2px;
    classDef definition fill:#FFF7ED,stroke:#D97706,color:#7C2D12,stroke-width:2px;
    classDef entry fill:#EEF2FF,stroke:#6366F1,color:#312E81,stroke-width:2px;
    classDef active fill:#FDF4FF,stroke:#C026D3,color:#701A75,stroke-width:2px;
    classDef result fill:#ECFDF5,stroke:#10B981,color:#064E3B,stroke-width:2px;
    class PROVIDER outside;
    class CATALOG,OPERATIONS,CONNECTION definition;
    class DIRECT,WORKFLOW,GRAPHQL entry;
    class RUN active;
    class RESULT result;
