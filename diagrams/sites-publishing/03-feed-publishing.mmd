flowchart LR
    classDef core fill:#2563eb,color:#ffffff,stroke:#1d4ed8,stroke-width:2px
    classDef content fill:#ecfdf5,color:#14532d,stroke:#22c55e,stroke-width:1.5px
    classDef identity fill:#f5f3ff,color:#4c1d95,stroke:#8b5cf6,stroke-width:1.5px
    classDef output fill:#fff7ed,color:#7c2d12,stroke:#f97316,stroke-width:1.5px

    records["Business content<br/>articles, news or product updates"]:::content
    stream["Which updates to publish<br/>choose and arrange the entries"]:::core
    items["Each update<br/>headline, link, summary, author and date"]:::content
    feed["Subscriber feed<br/>name, title, summary, author and website"]:::core
    size["How many recent updates to include"]:::identity
    rss["News and reading apps"]:::output
    atom["Subscription readers"]:::output
    json["Connected websites and products"]:::output
    readers["Subscribers"]:::output

    records -->|are chosen by the| stream
    stream -->|creates| items
    items -->|fill the| feed
    size -->|sets the size of the| feed
    feed -->|reaches| rss
    feed -->|reaches| atom
    feed -->|reaches| json
    rss -->|deliver updates to| readers
    atom -->|deliver updates to| readers
    json -->|deliver updates to| readers
